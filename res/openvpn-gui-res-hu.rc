/* Passphrase Dialog */
ID_DLG_PASSPHRASE DIALOGEX 6, 18, 160, 83
STYLE WS_POPUP | WS_VISIBLE | WS_CAPTION | DS_CENTER | DS_SETFOREGROUND
EXSTYLE WS_EX_TOPMOST
CAPTION "OpenVPN – Privát kulcs jelszava"
FONT 8, "Microsoft Sans Serif"
LANGUAGE LANG_HUNGARIAN, SUBLANG_DEFAULT
BEGIN
    LTEXT "Add meg a &jelszót:", 201, 6, 6, 100, 10
    EDITTEXT ID_EDT_PASSPHRASE, 6, 17, 107, 12, ES_PASSWORD | ES_AUTOHSCROLL
    ICON ID_ICO_EYE, ID_PASSWORD_REVEAL, 126, 18, 14, 14, SS_ICON|SS_NOTIFY|SS_REALSIZEIMAGE
    CHECKBOX "Jelszó &mentése", ID_CHK_SAVE_PASS, 6, 33, 100, 10
    PUSHBUTTON "&OK", IDOK, 20, 49, 50, 14
    PUSHBUTTON "&Mégse", IDCANCEL, 90, 49, 50, 14
    LTEXT "", ID_TXT_WARNING, 6, 65, 100, 10
END

/* Auth Username/Password Dialog */
ID_DLG_AUTH DIALOGEX 6, 18, 180, 95
STYLE WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | DS_CENTER | DS_SETFOREGROUND
EXSTYLE WS_EX_TOPMOST
FONT 8, "Microsoft Sans Serif"
LANGUAGE LANG_HUNGARIAN, SUBLANG_DEFAULT
BEGIN
    LTEXT "&Felhasználónév:", ID_LTEXT_USERNAME, 6, 9, 50, 10
    EDITTEXT ID_EDT_AUTH_USER, 60, 6, 94, 12, ES_AUTOHSCROLL
    LTEXT "&Jelszó:", ID_LTEXT_PASSWORD, 6, 26, 50, 10
    EDITTEXT ID_EDT_AUTH_PASS, 60, 23, 94, 12, ES_PASSWORD | ES_AUTOHSCROLL
    ICON ID_ICO_EYE, ID_PASSWORD_REVEAL, 156, 24, 14, 14, SS_ICON|SS_NOTIFY|SS_REALSIZEIMAGE
    CHECKBOX "Jelszó &mentése", ID_CHK_SAVE_PASS, 6, 42, 100, 10
    PUSHBUTTON "&OK", IDOK, 20, 58, 50, 14, BS_DEFPUSHBUTTON | WS_TABSTOP | WS_DISABLED
    PUSHBUTTON "&Mégse", IDCANCEL, 90, 58, 52, 14
    LTEXT "", ID_TXT_WARNING, 6, 80, 150, 10
END

/* Auth Username/Password/Challenge Dialog */
ID_DLG_AUTH_CHALLENGE DIALOGEX 6, 18, 180, 129
STYLE WS_POPUP | WS_VISIBLE | WS_CAPTION | DS_CENTER | DS_SETFOREGROUND
EXSTYLE WS_EX_TOPMOST
CAPTION "OpenVPN – Felhasználói hitelesítés"
FONT 8, "Microsoft Sans Serif"
LANGUAGE LANG_HUNGARIAN, SUBLANG_DEFAULT
BEGIN
    LTEXT "&Felhasználónév:", ID_LTEXT_USERNAME, 6, 9, 50, 10
    EDITTEXT ID_EDT_AUTH_USER, 60, 6, 94, 12, ES_AUTOHSCROLL
    LTEXT "&Jelszó:", ID_LTEXT_PASSWORD, 6, 26, 50, 10
    EDITTEXT ID_EDT_AUTH_PASS, 60, 23, 94, 12, ES_PASSWORD | ES_AUTOHSCROLL
    ICON ID_ICO_EYE, ID_PASSWORD_REVEAL, 156, 24, 14, 14, SS_ICON|SS_NOTIFY|SS_REALSIZEIMAGE
    LTEXT "&Válasz:", ID_LTEXT_RESPONSE, 6, 60, 50, 10
    LTEXT "", ID_TXT_AUTH_CHALLENGE, 6, 43, 148, 10
    EDITTEXT ID_EDT_AUTH_CHALLENGE, 60, 57, 94, 12, ES_PASSWORD | ES_AUTOHSCROLL
    CHECKBOX "Jelszó &mentése", ID_CHK_SAVE_PASS, 6, 76, 100, 10
    PUSHBUTTON "&OK", IDOK, 20, 92, 50, 14, BS_PUSHBUTTON | WS_TABSTOP | WS_DISABLED
    PUSHBUTTON "&Mégse", IDCANCEL, 90, 92, 52, 14
    LTEXT "", ID_TXT_WARNING, 6, 108, 150, 10
END

/* Challenge Response Dialog */
ID_DLG_CHALLENGE_RESPONSE DIALOGEX 6, 18, 212, 72
STYLE WS_SIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | DS_CENTER | DS_SETFOREGROUND
EXSTYLE WS_EX_TOPMOST
CAPTION "OpenVPN – Kihívás válasz (Challenge Response)"
FONT 8, "Microsoft Sans Serif"
LANGUAGE LANG_HUNGARIAN, SUBLANG_DEFAULT
BEGIN
    LTEXT "", ID_TXT_DESCRIPTION, 6, 9, 400, 20
    LTEXT "&Válasz:", ID_LTEXT_RESPONSE, 6, 30, 50, 10
    EDITTEXT ID_EDT_RESPONSE, 60, 27, 94, 12, ES_PASSWORD | ES_AUTOHSCROLL
    ICON ID_ICO_EYE, ID_PASSWORD_REVEAL, 156, 28, 14, 14, SS_ICON|SS_NOTIFY|SS_REALSIZEIMAGE
    PUSHBUTTON "&OK", IDOK, 20, 51, 50, 14, BS_PUSHBUTTON | WS_TABSTOP
    PUSHBUTTON "&Mégse", IDCANCEL, 90, 51, 52, 14
END

/* Status Dialog */
ID_DLG_STATUS DIALOG 6, 18, 380, 210
STYLE WS_SIZEBOX | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_CAPTION | DS_CENTER
CAPTION "OpenVPN"
FONT 8, "Microsoft Sans Serif"
LANGUAGE LANG_HUNGARIAN, SUBLANG_DEFAULT
BEGIN
    LTEXT "Kapcsolódás...", ID_TXT_STATUS, 20, 5, 200, 10
    LTEXT "", ID_TXT_BYTECOUNT, 20, 175, 200, 10
    LTEXT "OpenVPN GUI 11.y.0.0/2.4.x", ID_TXT_VERSION, 220, 175, 150, 10
    LTEXT "", ID_TXT_IP, 20, 160, 300, 10
    PUSHBUTTON "&Szétkapcsolás", ID_DISCONNECT, 50, 190, 50, 14
    PUSHBUTTON "&Újrakapcsolás", ID_RESTART, 150, 190, 50, 14
    PUSHBUTTON "&Leválasztás", ID_DETACH, 180, 190, 50, 14, WS_DISABLED
    PUSHBUTTON "&Elrejtés", ID_HIDE, 100, 190, 50, 14
END

/* Message Window. */
ID_DLG_MESSAGE DIALOG 6, 18, 278, 210
STYLE WS_SIZEBOX | WS_SYSMENU | WS_POPUP | WS_CAPTION | DS_CENTER | DS_SETFOREGROUND | DS_SETFONT
CAPTION "OpenVPN Üzenet"
FONT 9, "Segoe UI"
LANGUAGE LANG_HUNGARIAN, SUBLANG_DEFAULT
BEGIN
    CONTROL "", ID_TXT_MESSAGE, RICHEDIT_CLASSW, ES_MULTILINE | WS_VSCROLL | ES_AUTOVSCROLL |  NOT WS_BORDER | ES_READONLY | NOT WS_TABSTOP, 10, 10, 260, 190
END

/* Change Passphrase Dialog */
ID_DLG_CHGPASS DIALOG 6, 18, 193, 82
STYLE WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | DS_CENTER
CAPTION "OpenVPN – Privát kulcs jelszavának megváltoztatása"
FONT 8, "Microsoft Sans Serif"
LANGUAGE LANG_HUNGARIAN, SUBLANG_DEFAULT
BEGIN
    LTEXT "&Régi jelszó:", 171, 6, 9, 85, 10
    EDITTEXT ID_EDT_PASS_CUR, 95, 6, 90, 12, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "&Új jelszó:", 172, 6, 26, 85, 10
    EDITTEXT ID_EDT_PASS_NEW, 95, 23, 90, 12, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "Új jelszó m&egerősítése:", 173, 6, 42, 85, 10
    EDITTEXT ID_EDT_PASS_NEW2, 95, 39, 90, 12, ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON "&OK", IDOK, 40, 59, 50, 14
    PUSHBUTTON "&Mégse", IDCANCEL, 103, 59, 50, 14
    LTEXT "", ID_TXT_KEYFORMAT, 0, 0, 0, 0
    LTEXT "", ID_TXT_KEYFILE, 0, 0, 0, 0
END

/* Proxy Settings Dialog */
ID_DLG_PROXY DIALOG 6, 18, 249, 104
STYLE WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | DS_CENTER
CAPTION "Proxy"
FONT 8, "Microsoft Sans Serif"
LANGUAGE LANG_HUNGARIAN, SUBLANG_DEFAULT
BEGIN
    GROUPBOX "   ", 201, 6, 46, 235, 52
    AUTORADIOBUTTON "OpenVPN &konfigurációs fájl beállításainak használata", ID_RB_PROXY_OPENVPN,
                    13, 16, 200, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Rendszer &proxy beállításainak használata",
                    ID_RB_PROXY_MSIE, 13, 31, 200, 10
    AUTORADIOBUTTON "&Kézi konfiguráció", ID_RB_PROXY_MANUAL, 13, 46, 79, 10
    AUTORADIOBUTTON "&HTTP Proxy", ID_RB_PROXY_HTTP, 20, 62, 90, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&SOCKS Proxy", ID_RB_PROXY_SOCKS, 120, 62, 90, 10
    LTEXT "&Cím:", ID_TXT_PROXY_ADDRESS, 20, 77, 32, 10
    EDITTEXT ID_EDT_PROXY_ADDRESS, 53, 75, 117, 12, ES_AUTOHSCROLL
    RTEXT "&Port:", ID_TXT_PROXY_PORT, 171, 77, 20, 10
    EDITTEXT ID_EDT_PROXY_PORT, 196, 75, 30, 12, ES_AUTOHSCROLL
END

/* General Settings Dialog */
ID_DLG_GENERAL DIALOGEX 6, 18, 249, 104
STYLE WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | DS_CENTER
CAPTION "Általános"
FONT 8, "Microsoft Sans Serif"
LANGUAGE LANG_HUNGARIAN, SUBLANG_DEFAULT
BEGIN
    GROUPBOX "Felhasználói felület", 201, 6, 12, 235, 30
    LTEXT "&Nyelv:", ID_TXT_LANGUAGE, 17, 25, 52, 12
    COMBOBOX ID_CMB_LANGUAGE, 57, 23, 171, 400, CBS_DROPDOWNLIST | WS_TABSTOP

    GROUPBOX "Indítás", 202, 6, 47, 235, 30
    AUTOCHECKBOX "Indítás Windows be&lépéskor", ID_CHK_STARTUP, 17, 59, 120, 12

    GROUPBOX "Beállítások", ID_GROUPBOX3, 6, 82, 235, 180
    AUTOCHECKBOX "Hozzáadás a &naplófájlhoz", ID_CHK_LOG_APPEND, 17, 95, 100, 10
    AUTOCHECKBOX "Szkript &ablak megjelenítése", ID_CHK_SHOW_SCRIPT_WIN, 17, 110, 200, 10
    AUTOCHECKBOX "&Csendes kapcsolódás", ID_CHK_SILENT, 17, 125, 200, 10
    AUTOCHECKBOX "&Interaktív szolgáltatás használata mindig", ID_CHK_ALWAYS_USE_ISERVICE, 17, 140, 200, 10
    LTEXT "Buborékértesítés", ID_TXT_BALLOON, 17, 155, 100, 10
    AUTORADIOBUTTON "Kapcsolódáskor", ID_RB_BALLOON1, 28, 170, 70, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Kapcsolódáskor/&újrakapcsolódáskor", ID_RB_BALLOON2, 100, 170, 120, 10
    AUTORADIOBUTTON "&Soha", ID_RB_BALLOON0, 221, 170, 40, 10
    LTEXT "Állandó kapcsolatok", ID_TXT_PERSISTENT, 17, 185, 100, 10
    AUTORADIOBUTTON "A&utomatikus", ID_RB_BALLOON3, 28, 200, 50, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Kézi", ID_RB_BALLOON4, 86, 200, 90, 10
    AUTORADIOBUTTON "&Letiltva", ID_RB_BALLOON5, 181, 200, 50, 10
    AUTOCHECKBOX "Bejelentkezés előtti hozzáférés engedélyezése (admin jog kell)", ID_CHK_PLAP_REG, 17, 215, 220, 10
    AUTOCHECKBOX "Aktív kapcsolatok automatikus újraindítása", ID_CHK_AUTO_RESTART, 17, 230, 200, 10
    AUTOCHECKBOX "OTP kérése és egyesítése a jelszóval", ID_CHK_CONCAT_OTP, 17, 245, 200, 10
END

/* Advanced Dialog */
ID_DLG_ADVANCED DIALOGEX 6, 18, 252, ADVANCED_DIALOG_HEIGHT
STYLE WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | DS_CENTER
CAPTION "Speciális"
FONT 8, "Microsoft Sans Serif"
LANGUAGE LANG_HUNGARIAN, SUBLANG_DEFAULT
BEGIN
    GROUPBOX "Konfigurációs fájlok", 201, 6, 12, 235, 45
    LTEXT "&Mappa:", ID_TXT_FOLDER, 17, 25, 32, 10
    EDITTEXT ID_EDT_CONFIG_DIR, 53, 23, 150, 12, ES_AUTOHSCROLL
    LTEXT "&Kiterjesztés:", ID_TXT_EXTENSION, 17, 40, 52, 10
    EDITTEXT ID_EDT_CONFIG_EXT, 53, 38, 25, 12, ES_AUTOHSCROLL
    PUSHBUTTON "…", ID_BTN_CONFIG_DIR, 208, 23, 25, 12

    GROUPBOX "Naplófájlok", 202, 6, 62, 235, 30
    LTEXT "M&appa:", ID_TXT_FOLDER1, 17, 74, 32, 10
    EDITTEXT ID_EDT_LOG_DIR, 53, 72, 150, 12, ES_AUTOHSCROLL
    PUSHBUTTON "…", ID_BTN_LOG_DIR, 208, 72, 25, 12

    GROUPBOX "Szkript időtúllépés", 203, 6, 97, 235, 60
    LTEXT "&Kapcsolódás előtti szkript időtúllépése:", ID_TXT_PRECONNECT_TIMEOUT, 17, 110, 130, 10
    EDITTEXT ID_EDT_PRECONNECT_TIMEOUT, 150, 108, 20, 12, ES_AUTOHSCROLL|ES_NUMBER
    LTEXT "&Kapcsolódási szkript időtúllépése:", ID_TXT_CONNECT_TIMEOUT, 17, 125, 130, 10
    EDITTEXT ID_EDT_CONNECT_TIMEOUT, 150, 123, 20, 12, ES_AUTOHSCROLL|ES_NUMBER
    LTEXT "&Szétkapcsolási szkript időtúllépése:", ID_TXT_DISCONNECT_TIMEOUT, 17, 140, 130, 10
    EDITTEXT ID_EDT_DISCONNECT_TIMEOUT, 150, 138, 20, 12, ES_AUTOHSCROLL|ES_NUMBER

    GROUPBOX "Felügyeleti (Management) interfész", 204, 6, 163, 235, 30
    LTEXT "Port eltolás (offset):", 205, 17, 175, 75, 10
    EDITTEXT ID_EDT_MGMT_PORT, 103, 173, 30, 12, ES_AUTOHSCROLL

    GROUPBOX "Konfigurációs menü nézet", 206, 6, 198, 235, 30
    AUTORADIOBUTTON "&Auto", ID_RB_BALLOON0, 28, 210, 50, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Lapos", ID_RB_BALLOON1, 88, 210, 50, 10
    AUTORADIOBUTTON "&Beágyazott", ID_RB_BALLOON2, 148, 210, 50, 10

    GROUPBOX "Visszhangüzenet megjelenítése", 207, 6, 233, 235, 45
    AUTORADIOBUTTON "A&uto", ID_RB_BALLOON3, 28, 245, 50, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "S&oha", ID_RB_BALLOON4, 88, 245, 50, 10
    LTEXT "Az ismétlődő üzenetek némítva:", 208, 17, 260, 125, 10
    EDITTEXT ID_EDT_POPUP_MUTE, 150, 258, 30, 12, ES_AUTOHSCROLL
    LTEXT "óra", 209, 190, 260, 40, 10

#if ENABLE_OVPN3
    GROUPBOX "OpenVPN Motor", ID_RB_ENGINE_SELECTION, 6, 283, 235, 30
    AUTORADIOBUTTON "OpenVPN2", ID_RB_ENGINE_OVPN2, 18, 296, 50, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "OpenVPN3 (kísérleti)", ID_RB_ENGINE_OVPN3, 76, 296, 100, 10
#endif

END

/* About Dialog */
ID_DLG_ABOUT DIALOG 6, 18, 249, 104
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_CENTER
CAPTION "Névjegy"
FONT 8, "Microsoft Sans Serif"
LANGUAGE LANG_HUNGARIAN, SUBLANG_DEFAULT
BEGIN
    ICON ID_ICO_APP, ID_ICON_ABOUT, 8, 16, 21, 20
    LTEXT "OpenVPN GUI v%ls – Windows GUI az OpenVPN-hez\n\
Copyright (C) 2004-2005 Mathias Sundman <info@openvpn.se>\n\
Copyright (C) 2008-2014 Heiko Hund <heikoh@users.sf.net>\n\
Copyright (C) 2012-2026 OpenVPN GUI közreműködők\n", ID_TXT_VERSION, 36, 15, 206, 50
    LTEXT "https://github.com/OpenVPN/openvpn-gui/", ID_LTEXT_ABOUT2, 36, 55, 206, 42
    LTEXT "OpenVPN – Alkalmazás biztonságos IP hálózati alagutak létesítésére \
egyetlen TCP/UDP porton keresztül, SSL/TLS alapú munkamenet-hitelesítéssel, \
kulcscserével, csomagtitkosítással, csomaghitelesítéssel és tömörítéssel.\n\
\n", ID_LTEXT_ABOUT3, 8, 70, 240, 64
    LTEXT "Copyright (C) 2002-2026 OpenVPN Technologies, Inc <info@openvpn.net>\n\
https://openvpn.net/", ID_LTEXT_ABOUT4, 8, 106, 240, 64
END

/* Proxy Authentication Dialog */
ID_DLG_PROXY_AUTH DIALOGEX 29, 23, 170, 65
STYLE DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | DS_CENTER
EXSTYLE WS_EX_TOPMOST
CAPTION "OpenVPN – Proxy hitelesítés"
FONT 8, "Microsoft Sans Serif"
LANGUAGE LANG_HUNGARIAN, SUBLANG_DEFAULT
BEGIN
    LTEXT "&Felhasználónév:", 201, 9, 8, 50, 10
    EDITTEXT ID_EDT_PROXY_USER, 60, 5, 94, 12, ES_AUTOHSCROLL
    LTEXT "&Jelszó:", 202, 9, 26, 50, 10
    EDITTEXT ID_EDT_PROXY_PASS, 60, 23, 94, 12, ES_PASSWORD | ES_AUTOHSCROLL
    ICON ID_ICO_EYE, ID_PASSWORD_REVEAL, 156, 24, 14, 14, SS_ICON|SS_NOTIFY|SS_REALSIZEIMAGE
    PUSHBUTTON "&OK", IDOK, 58, 43, 40, 14, BS_PUSHBUTTON | WS_TABSTOP | WS_DISABLED
END

/* URL Profile Import Dialog */
ID_DLG_URL_PROFILE_IMPORT DIALOGEX 6, 18, 249, 95
STYLE WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | DS_CENTER | DS_SETFOREGROUND
CAPTION "Profil importálása az Access Serverről"
FONT 8, "Microsoft Sans Serif"
LANGUAGE LANG_HUNGARIAN, SUBLANG_DEFAULT
BEGIN
    LTEXT "U&RL:", 201, 6, 9, 50, 10
    EDITTEXT ID_EDT_URL, 60, 6, 183, 12, ES_AUTOHSCROLL
    LTEXT "&Felhasználónév:", 202, 6, 26, 50, 10
    EDITTEXT ID_EDT_AUTH_USER, 60, 23, 94, 12, ES_AUTOHSCROLL
    LTEXT "&Jelszó:", ID_LTEXT_PASSWORD, 6, 42, 50, 10
    EDITTEXT ID_EDT_AUTH_PASS, 60, 40, 94, 12, ES_PASSWORD | ES_AUTOHSCROLL
    ICON ID_ICO_EYE, ID_PASSWORD_REVEAL, 156, 41, 14, 14, SS_ICON|SS_NOTIFY|SS_REALSIZEIMAGE
    AUTOCHECKBOX "&Automatikus bejelentkezés", ID_CHK_AUTOLOGIN, 6, 59, 140, 10
    PUSHBUTTON "&OK", IDOK, 20, 76, 50, 14, BS_PUSHBUTTON | WS_TABSTOP | WS_DISABLED
    PUSHBUTTON "&Mégse", IDCANCEL, 90, 76, 52, 14
END

/* Query PKCS11-ID Dialog */
ID_DLG_PKCS11_QUERY DIALOGEX 6, 18, 340, 242
STYLE WS_SIZEBOX| WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | DS_CENTER | DS_SETFONT
CAPTION "Tanúsítvány kiválasztása"
FONT 8, "Segoe UI"
LANGUAGE LANG_HUNGARIAN, SUBLANG_DEFAULT
BEGIN
    LTEXT "Elérhető PKCS11 tanúsítványok:", ID_TXT_PKCS11, 17, 12, 171, 12
    CONTROL "", ID_LVW_PKCS11, "SysListView32", LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 17, 25, 171, 150
    PUSHBUTTON "&OK", IDOK, 20, 200, 50, 14, BS_DEFPUSHBUTTON | WS_TABSTOP
    PUSHBUTTON "&Mégse", IDCANCEL, 90, 200, 50, 14, BS_PUSHBUTTON | WS_TABSTOP
    PUSHBUTTON "&Újra", IDRETRY, 160, 200, 50, 14, BS_PUSHBUTTON | WS_TABSTOP
    LTEXT "", ID_TXT_WARNING, 6, 222, 190, 10
END

/* QR code dialog */
ID_DLG_QR DIALOGEX 0, 0, 10, 10
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 8, "Segoe UI"
LANGUAGE LANG_HUNGARIAN, SUBLANG_DEFAULT
BEGIN
    CONTROL "", ID_STATIC_QR, "Static", SS_BITMAP | WS_VISIBLE | SS_CENTERIMAGE, 0, 0, 10, 10
    LTEXT " Olvasd be ezt a QR-kódot a mobilodon a hitelesítés folytatásához.", ID_TXT_QR, 0, 0, 10, 10, SS_CENTER | WS_VISIBLE | SS_EDITCONTROL
END

STRINGTABLE
LANGUAGE LANG_HUNGARIAN, SUBLANG_DEFAULT
BEGIN
    IDS_LANGUAGE_NAME "Hungarian"

    /* Tray – Resources */
    IDS_TIP_CONNECTED "\nKapcsolódva: "
    IDS_TIP_CONNECTING "\nKapcsolódás ide: "
    IDS_TIP_CONNECTED_SINCE "\nKapcsolódva ekkor óta: "
    IDS_TIP_ASSIGNED_IP "\nKiosztott IP: %ls"
    IDS_MENU_IMPORT "Importálás"
    IDS_MENU_IMPORT_AS "Importálás Access Serverről…"
    IDS_MENU_IMPORT_URL "Importálás URL-ről…"
    IDS_MENU_IMPORT_FILE "Fájl importálása…"
    IDS_MENU_SETTINGS "Beállítások…"
    IDS_MENU_CLOSE "Kilépés"
    IDS_MENU_CONNECT "Kapcsolódás"
    IDS_MENU_DISCONNECT "Szétkapcsolás"
    IDS_MENU_RECONNECT "Újrakapcsolás"
    IDS_MENU_STATUS "Állapot megjelenítése"
    IDS_MENU_VIEWLOG "Napló megtekintése"
    IDS_MENU_EDITCONFIG "Konfig szerkesztése"
    IDS_MENU_CLEARPASS  "Mentett jelszavak törlése"

    /* Logviewer – Resources */
    IDS_ERR_START_LOG_VIEWER "Hiba a naplómegjelenítő indításakor: %ls"
    IDS_ERR_START_CONF_EDITOR "Hiba a konfig-szerkesztő indításakor: %ls"

    /* OpenVPN */
    IDS_NFO_NO_CONFIGS "Nem található olvasható kapcsolatprofil (konfigurációs fájl).\n\
Használd a ""Fájl importálása..."" menüt, vagy másold a konfig fájlokat ide: ""%ls"" vagy ""%ls""."
    IDS_ERR_CONFIG_NOT_AUTHORIZED "A kapcsolat (%ls) indításához tagság szükséges a következő csoportban: \
""%ls"". Lépj kapcsolatba a rendszergazdával.\n"
    IDS_ERR_CONFIG_TRY_AUTHORIZE  "A kapcsolat (%ls) indításához tagság szükséges a következő csoportban: \
""%ls"".\n\n\
Szeretnéd hozzáadni magad ehhez a csoporthoz?\n\
Ez a művelet rendszergazdai jelszót vagy jóváhagyást kérhet."
    IDS_NFO_CONFIG_AUTH_PENDING   "A kapcsolat (%ls) indításához tagság szükséges a következő csoportban: \
""%ls"".\n\n\
Kérlek, fejezd be az előző engedélyezési ablakot."
    IDS_ERR_ADD_USER_TO_ADMIN_GROUP "A felhasználó hozzáadása a(z) ""%ls"" csoporthoz sikertelen."
    IDS_ERR_CREATE_EVENT "A CreateEvent sikertelen a kilépési eseménynél: %ls"
    IDS_ERR_UNKNOWN_PRIORITY "Ismeretlen prioritásnév: %ls"
    IDS_ERR_INIT_SEC_DESC "A InitializeSecurityDescriptor sikertelen."
    IDS_ERR_SET_SEC_DESC_ACL "A SetSecurityDescriptorDacl sikertelen."
